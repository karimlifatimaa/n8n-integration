{
  "name": "Error Handling Workflow",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "webhook/error",
        "options": {}
      },
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "model": "gpt-3.5-turbo",
        "prompt": {
          "messages": [
            {
              "role": "system",
              "content": "Sən Senior Backend Developerisən. Gələn xətanı texniki baxımdan analiz et və həll yolları təklif et."
            },
            {
              "role": "user",
              "content": "Service: {{ $json.service_name }}\nError: {{ $json.error_message }}\nStacktrace: {{ $json.error_stacktrace }}"
            }
          ]
        }
      },
      "name": "AI Agent",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1,
      "position": [
        450,
        300
      ]
    },
    {
      "parameters": {
        "chatId": "YOUR_CHAT_ID",
        "text": "🚨 **Error in {{ $node[\"Webhook\"].json[\"service_name\"] }}** 🚨\n\n**Message:** {{ $node[\"Webhook\"].json[\"error_message\"] }}\n\n**AI Analysis:**\n{{ $json.content }}",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "name": "Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [
        650,
        300
      ]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "AI Agent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "AI Agent": {
      "main": [
        [
          {
            "node": "Telegram",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
